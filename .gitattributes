# Define LF como padrão para todos os arquivos de texto
* text=auto eol=lf

# Scripts e arquivos de build sem extensão
Containerfile text eol=lf
ornos-first-setup text eol=lf
ornos-deck-session text eol=lf
kwinrc text eol=lf
system_files/usr/bin/* text eol=lf

# Scripts Shell e Automação
*.sh text eol=lf
*.just text eol=lf
*.py text eol=lf

# Configurações do Sistema, Kernel, KDE e Jogos
*.conf text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.toml text eol=lf
*.rules text eol=lf
*.service text eol=lf
*.timer text eol=lf

# Interface, Temas Plymouth e Atalhos
*.desktop text eol=lf
*.plymouth text eol=lf
*.script text eol=lf
*.xml text eol=lf
*.svg text eol=lf

# Workflows CI/CD e Documentação
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Arquivos Binários e Imagens (impede o Git de alterar bytes de imagens/fontes)
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff2 binary