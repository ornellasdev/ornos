# OrnOS Plymouth theme — script plugin
# Colors: violet -> electric blue -> cyan
Window.SetBackgroundTopColor(0.015, 0.008, 0.035);
Window.SetBackgroundBottomColor(0.005, 0.008, 0.025);

logo_image = Image("logo.png");
logo_sprite = Sprite(logo_image);
logo_sprite.SetX(Window.GetWidth() / 2 - logo_image.GetWidth() / 2);
logo_sprite.SetY(Window.GetHeight() * 0.34 - logo_image.GetHeight() / 2);

# Progress bar is drawn with a thin cyan outline and gradient-like segments.
bar_width = Window.GetWidth() * 0.34;
bar_height = Math.max(8, Window.GetHeight() * 0.012);
bar_x = Window.GetWidth() / 2 - bar_width / 2;
bar_y = Window.GetHeight() * 0.70;

bar_bg_image = Image(bar_width, bar_height);
bar_bg_image.SetBackgroundColor(0.025, 0.04, 0.09);
bar_bg = Sprite(bar_bg_image);
bar_bg.SetX(bar_x); bar_bg.SetY(bar_y);

bar_fill_image = Image(bar_width, bar_height);
bar_fill_sprite = Sprite(bar_fill_image);
bar_fill_sprite.SetX(bar_x); bar_fill_sprite.SetY(bar_y);

# A small glowing pulse under the bar
pulse_image = Image("spinner.png");
pulse_sprite = Sprite(pulse_image);
pulse_sprite.SetX(Window.GetWidth()/2 - pulse_image.GetWidth()/2);
pulse_sprite.SetY(bar_y + bar_height + 24);

progress = 0.0;
fun refresh_callback () {
    # Plymouth progress is delivered as a fraction by system updates.
    progress = Plymouth.GetBootProgress();
    if (progress < 0) progress = 0;
    if (progress > 1) progress = 1;
    fill_width = Math.max(1, bar_width * progress);
    bar_fill_sprite.SetImage(Image(fill_width, bar_height));
    bar_fill_sprite.GetImage().SetBackgroundColor(0.72, 0.08, 0.98);
}
Plymouth.SetRefreshFunction(refresh_callback);

fun quit_callback () {
    logo_sprite.SetOpacity(1);
}
Plymouth.SetQuitFunction(quit_callback);